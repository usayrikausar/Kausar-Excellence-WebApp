# Firebase Hosting's Next.js framework integration merges this file into the
# environment of the `next build` subprocess it spawns for this specific
# project (see firebase-tools/lib/frameworks/next/index.js — it reads
# `.env.<projectId>`). Next.js 16 defaults `next build` to Turbopack with no
# way to pass `--webpack` through Firebase's build invocation, and Turbopack's
# externals handling currently mis-names the firebase-admin package when
# packaged for Cloud Functions (`Cannot find package
# 'firebase-admin-<hash>'` at runtime) — forcing webpack here is the
# workaround, via the (real, documented) bundler-selection env var in
# next/dist/lib/bundler.js.
IS_WEBPACK_TEST=1
