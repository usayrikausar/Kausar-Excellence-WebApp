rules_version = '2';

// Phase 1: only bulletin images live in Storage, and only group admins upload
// them (created via the /bulletin/new form). Everyone signed-in can view.
service firebase.storage {
  match /b/{bucket}/o {
    match /bulletins/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.isGroupAdmin == true;
    }
    match /contests/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.isGroupAdmin == true;
    }
  }
}
